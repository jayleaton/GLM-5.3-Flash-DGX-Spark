+def _trellis_codebook_asm(codebook: str) -> tuple[str, str, str]:
+    """(register/constant preamble, per-window decode, fragment pack) PTX for one codebook.
+
+    Both variants leave each window register holding a 16-bit fp16 pattern in
+    the low half (MCG: two halves that are summed; MUL1: one fp16 integer), and
+    pack pairs with prmt 0x5410 so element/lane order is identical.
+    """
+    codebook = str(codebook).lower()
+    if codebook == "mcg":
+        return (
+            "mov.b32 M, __MCG__;",
+            "mul.lo.u32 {w}, {w}, M;  lop3.b32 {w}, {w}, __MASK__, __OR__, 0x6a;",
+            "prmt.b32 lo, {a}, {b}, 0x5410;  prmt.b32 hi, {a}, {b}, 0x7632;  add.rn.f16x2 {o}, lo, hi;",
+        )
+    if codebook == "mul1":
+        return (
+            "mov.b32 M, __MUL1__;  mov.b32 ONES, __ONES__;  mov.b32 ACC, __ACC__;  "
+            "mov.b32 KINV, __KINV__;  mov.b32 KBIAS, __KBIAS__;",
+            "mul.lo.u32 {w}, {w}, M;  dp4a.u32.u32 {w}, {w}, ONES, ACC;",
+            "prmt.b32 lo, {a}, {b}, 0x5410;  fma.rn.f16x2 {o}, lo, KINV, KBIAS;",
+        )
+    raise ValueError(f"unsupported trellis codebook {codebook!r}; expected one of {_TRELLIS_CODEBOOKS}")
+
+
+def _trellis_decode_tail(codebook: str) -> str:
+    pre, dec, pack = _trellis_codebook_asm(codebook)
+    lines = [dec.format(w=f"w{i}") for i in range(8)]
+    lines += [pack.format(a=f"w{2 * i}", b=f"w{2 * i + 1}", o=f"${i}") for i in range(4)]
+    return pre, "\n            ".join(lines)
+
