             return UnquantizedLinearMethod()
         return None
+
+
+def _module_class(module: str) -> str:
+    """Checkpoint module -> class label used in announcements and the byte report (layer index dropped)."""
+    if module == "lm_head":
+        return "lm_head"
+    if module.startswith("model.visual"):
+        return "vision." + module.split(".")[-1]
+    parts = module.split(".")
+    return ".".join(parts[4:]) if len(parts) > 4 else module
