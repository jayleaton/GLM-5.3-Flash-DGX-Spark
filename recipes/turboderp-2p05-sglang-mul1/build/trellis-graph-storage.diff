+                             f"tokens ({MAX_BATCH_TOKENS_ENV}) under CUDA graph capture")
+        else:
+            # Eager only (e.g. an unchunked vision tower above the cap): the kernel allocates per call.
+            out = layer.exl3_api.run(x2, layer.exl3_weight)
+        out = out.reshape(*x.shape[:-1], self.out_features)
         return out if bias is None else out + bias
